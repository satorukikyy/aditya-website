# Public canonical URL of your deployed site
NEXT_PUBLIC_SITE_URL=https://rizkyaditya.dev

# Real Journal Views Storage (Recommended for Serverless / Vercel Production)
# Connect Upstash Redis (free tier) or Vercel Marketplace Upstash Redis.
# When omitted (localhost / self-hosted VPS), views persist locally in .data/journal-views.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional random secret used to salt SHA-256 visitor dedup hashes (never stores raw IPs)
VIEWS_HASH_SALT=
